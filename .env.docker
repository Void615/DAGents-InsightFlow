# =====================================================================
# DAGents-InsightFlow Docker 环境变量模板
# =====================================================================
# 复制为 .env 并填入真实值:  cp .env.docker .env
# docker-compose 会自动读取当前目录的 .env 文件
# =====================================================================

# ── PostgreSQL ──────────────────────────────────────────────────
PG_PASSWORD=change-me-to-a-strong-password

# ── JWT ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret

# ── LLM（火山方舟）─────────────────────────────────────────────
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/
LLM_MODEL=your-llm-model-name

# ── 搜索 ────────────────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key

# ── CORS（逗号分隔，含 http:// 或 https://）─────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost

# ── LangSmith 追踪（可选）───────────────────────────────────────
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dagents-insightflow
